{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "scripts/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-dev/dev/types/**/*.ts",
    "**/*.mts",
    ".next-codex/types/**/*.ts",
    ".next-codex/dev/types/**/*.ts",
    ".next-fast/types/**/*.ts",
    ".next-fast/dev/types/**/*.ts",
    ".next-fix/types/**/*.ts",
    ".next-fix/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/**",
    ".next-dev/**",
    ".next-codex/**",
    ".next-fast/**",
    ".next-fix/**"
  ]
}
